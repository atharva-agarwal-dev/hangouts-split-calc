rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function secretId(value) {
      return value is string && value.matches('^[a-f0-9]{64}$');
    }

    function validData(data) {
      return data is map
        && data.keys().hasAll(['name', 'date', 'people', 'payments', 'settlements', 'closed'])
        && data.keys().hasOnly(['name', 'date', 'people', 'payments', 'settlements', 'closed'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.people is list && data.people.size() >= 2 && data.people.size() <= 30
        && data.payments is list && data.payments.size() <= 500
        && data.settlements is list && data.settlements.size() <= 15000
        && data.closed is bool;
    }

    function validEvent(data) {
      return data.keys().hasAll(['ownerUid', 'revision', 'data', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'revision', 'data', 'createdAt', 'updatedAt'])
        && data.ownerUid is string
        && data.revision is int && data.revision > 0
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validData(data.data);
    }

    function editorOf(eventId) {
      return signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || exists(/databases/$(database)/documents/events/$(eventId)/editors/$(request.auth.uid)));
    }

    match /events/{eventId} {
      // Knowing the 256-bit event ID grants viewing. Queries cannot enumerate events.
      allow get: if signedIn() && secretId(eventId);
      allow list: if false;
      allow create: if signedIn() && secretId(eventId)
        && validEvent(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if editorOf(eventId)
        && validEvent(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /editors/{uid} {
        // Each claimed grant is private to the device identity that claimed it.
        allow get: if signedIn() && uid == request.auth.uid;
        allow list, update, delete: if false;
        allow create: if signedIn() && uid == request.auth.uid
          && secretId(eventId)
          && request.resource.data.keys().hasAll(['token', 'createdAt'])
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && secretId(request.resource.data.token)
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/editLinks/$(request.resource.data.token)).data.eventId == eventId
          && get(/databases/$(database)/documents/editLinks/$(request.resource.data.token)).data.ownerUid
            == get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid;
      }
    }

    match /editLinks/{token} {
      // A key holder can claim a device grant. These documents are never listed
      // and the edit key never appears in the event document shared with viewers.
      allow get: if signedIn() && secretId(token);
      allow list, update, delete: if false;
      allow create: if signedIn() && secretId(token)
        && request.resource.data.keys().hasAll(['eventId', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['eventId', 'ownerUid', 'createdAt'])
        && secretId(request.resource.data.eventId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
